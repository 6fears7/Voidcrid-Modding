<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Voidcrid</AssemblyName>
    <RootNamespace>Voidcrid</RootNamespace>
    <!-- Keep in sync with packaging/manifest.json and the [BepInPlugin] version. -->
    <Version>1.6.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <ModLibsDir>$(RepoRoot)libs\</ModLibsDir>
    <AssetsDir>$(RepoRoot)assets\</AssetsDir>
  </PropertyGroup>

  <!-- Game, BepInEx and R2API assemblies all come from NuGet. Do not vendor these into libs\. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- Matches the shipping game: RoR2 1.4.1 on Unity 2021.3.33f1. -->
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="MMHOOK.RoR2" Version="2025.12.9">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.Networking" Version="1.0.4" />
    <PackageReference Include="R2API.Language" Version="1.1.0" />
    <PackageReference Include="R2API.ContentManagement" Version="1.0.11" />
    <PackageReference Include="R2API.Unlockable" Version="1.0.2" />
    <PackageReference Include="R2API.Loadout" Version="1.0.2" />
    <PackageReference Include="R2API.Prefab" Version="1.1.1" />
    <PackageReference Include="R2API.DamageType" Version="1.1.7" />
  </ItemGroup>

  <!--
    Soft dependencies on other Thunderstore mods. These are not published to NuGet, so their
    assemblies are vendored in libs\ at the repo root. Private=false keeps them out of the build
    output: at runtime the real mod supplies them, and Voidcrid degrades gracefully when one is
    absent (see the SoftDependency entries on VoidcridDef).
  -->
  <ItemGroup>
    <Reference Include="AncientScepter">
      <HintPath>$(ModLibsDir)AncientScepter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GrooveSaladSpikestripContent">
      <HintPath>$(ModLibsDir)GrooveSaladSpikestripContent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NoopSpikestrip">
      <HintPath>$(ModLibsDir)NoopSpikestrip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlasmaCoreSpikestripContent">
      <HintPath>$(ModLibsDir)PlasmaCoreSpikestripContent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skills">
      <HintPath>$(ModLibsDir)Skills.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The AssetBundle built by the ThunderKit project in unity\. SkillSetup.LoadAssetBundle resolves
    it as a sibling of Voidcrid.dll, so it has to land in the output directory.
  -->
  <ItemGroup>
    <None Include="$(AssetsDir)acrid3">
      <Link>acrid3</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Mirror the build output into a single config-independent directory so a mod manager profile can
    symlink at a stable path. Without this the symlink would have to name a configuration, and a
    plain `dotnet build` (Debug) would leave the game running the last Release build instead.
    See docs/DEVELOPMENT.md, "Live-testing through r2modman".
  -->
  <PropertyGroup>
    <LiveDir>$(MSBuildThisFileDirectory)bin\live\</LiveDir>
  </PropertyGroup>

  <Target Name="StageLiveBuild" AfterTargets="Build">
    <ItemGroup>
      <LivePayload Include="$(TargetPath)" />
      <LivePayload Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <LivePayload Include="$(TargetDir)acrid3" />
    </ItemGroup>
    <Copy SourceFiles="@(LivePayload)" DestinationFolder="$(LiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
