<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Voidcrid</AssemblyName>
    <RootNamespace>Voidcrid</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <ModLibsDir>$(RepoRoot)libs\</ModLibsDir>
    <AssetsDir>$(RepoRoot)assets\</AssetsDir>
  </PropertyGroup>

  <!--
    packaging/manifest.json is the single source of truth for the mod version. <Version> is read
    from it here at evaluation time, so nothing needs hand-syncing.
  -->
  <PropertyGroup>
    <VersionManifestPath>$(RepoRoot)packaging\manifest.json</VersionManifestPath>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(VersionManifestPath)')), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

  <Target Name="CheckVersionManifest" BeforeTargets="BeforeBuild;GenerateVersionConstant;GetAssemblyVersion">
    <Error Condition="'$(Version)' == ''" Text="Could not read version_number from $(VersionManifestPath)." />
  </Target>

  <!--
    Exposes <Version> to VoidcridPlugin.cs as a compiled constant so the [BepInPlugin] version
    attribute never needs hand-editing.
  -->
  <Target Name="GenerateVersionConstant" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VersionConstantFile>$(IntermediateOutputPath)PluginVersion.g.cs</VersionConstantFile>
      <VersionConstantContent>namespace Voidcrid { internal static class PluginVersion { public const string Value = "$(Version)"; } }</VersionConstantContent>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <WriteLinesToFile File="$(VersionConstantFile)" Lines="$([MSBuild]::Escape($(VersionConstantContent)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(VersionConstantFile)" />
    </ItemGroup>
  </Target>

  <!--
    -p:Bump=patch|minor|major bumps packaging/manifest.json's version_number and feeds the new
    version into the rest of this build. A plain build (no Bump) is a no-op. The manifest is the
    only file rewritten: it has no backslashes or semicolons, so WriteLinesToFile is safe on it.
  -->
  <Target Name="BumpVersion" BeforeTargets="GenerateVersionConstant;GetAssemblyVersion" Condition="'$(Bump)' != ''">
    <Error Condition="'$(Bump)' != 'patch' and '$(Bump)' != 'minor' and '$(Bump)' != 'major'"
           Text="Invalid -p:Bump value '$(Bump)'. Use patch, minor or major." />

    <PropertyGroup>
      <OldVersion>$(Version)</OldVersion>
      <VersionMajor>$(Version.Split('.')[0])</VersionMajor>
      <VersionMinor>$(Version.Split('.')[1])</VersionMinor>
      <VersionPatch>$(Version.Split('.')[2])</VersionPatch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Bump)' == 'major'">
      <NewVersion>$([MSBuild]::Add($(VersionMajor), 1)).0.0</NewVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Bump)' == 'minor'">
      <NewVersion>$(VersionMajor).$([MSBuild]::Add($(VersionMinor), 1)).0</NewVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Bump)' == 'patch'">
      <NewVersion>$(VersionMajor).$(VersionMinor).$([MSBuild]::Add($(VersionPatch), 1))</NewVersion>
    </PropertyGroup>

    <PropertyGroup>
      <ManifestBumpText>$([System.IO.File]::ReadAllText('$(VersionManifestPath)'))</ManifestBumpText>
      <ManifestBumpText>$([System.Text.RegularExpressions.Regex]::Replace($(ManifestBumpText), '"version_number"\s*:\s*"[^"]+"', '"version_number": "$(NewVersion)"'))</ManifestBumpText>
    </PropertyGroup>
    <WriteLinesToFile File="$(VersionManifestPath)" Lines="$(ManifestBumpText.TrimEnd())" Overwrite="true" />

    <PropertyGroup>
      <Version>$(NewVersion)</Version>
      <AssemblyVersion>$(NewVersion)</AssemblyVersion>
      <FileVersion>$(NewVersion)</FileVersion>
      <InformationalVersion>$(NewVersion)</InformationalVersion>
      <PackageVersion>$(NewVersion)</PackageVersion>
    </PropertyGroup>

    <Message Importance="high" Text="Voidcrid version $(OldVersion) -&gt; $(NewVersion)" />
  </Target>

  <!-- Game, BepInEx and R2API assemblies all come from NuGet. Do not vendor these into libs\. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- Matches the shipping game: RoR2 1.4.1 on Unity 2021.3.33f1. -->
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="MMHOOK.RoR2" Version="2025.12.9">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
    <PackageReference Include="R2API.Core" Version="5.3.0" />
    <PackageReference Include="R2API.Networking" Version="1.0.4" />
    <PackageReference Include="R2API.Language" Version="1.1.0" />
    <PackageReference Include="R2API.ContentManagement" Version="1.0.11" />
    <PackageReference Include="R2API.Unlockable" Version="1.0.2" />
    <PackageReference Include="R2API.Loadout" Version="1.0.2" />
    <PackageReference Include="R2API.Prefab" Version="1.1.1" />
    <PackageReference Include="R2API.DamageType" Version="1.1.7" />
    <PackageReference Include="R2API.Skins" Version="1.4.7" />
  </ItemGroup>

  <!--
    Soft dependencies on other Thunderstore mods. These are not published to NuGet, so their
    assemblies are vendored in libs\ at the repo root. Private=false keeps them out of the build
    output: at runtime the real mod supplies them, and Voidcrid degrades gracefully when one is
    absent (see the SoftDependency entries on VoidcridDef).
  -->
  <ItemGroup>
    <Reference Include="AncientScepter">
      <HintPath>$(ModLibsDir)AncientScepter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GrooveSaladSpikestripContent">
      <HintPath>$(ModLibsDir)GrooveSaladSpikestripContent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NoopSpikestrip">
      <HintPath>$(ModLibsDir)NoopSpikestrip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlasmaCoreSpikestripContent">
      <HintPath>$(ModLibsDir)PlasmaCoreSpikestripContent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Skills">
      <HintPath>$(ModLibsDir)Skills.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    The AssetBundle built by the ThunderKit project in unity\. SkillSetup.LoadAssetBundle resolves
    it as a sibling of Voidcrid.dll, so it has to land in the output directory.
  -->
  <ItemGroup>
    <None Include="$(AssetsDir)acrid3">
      <Link>acrid3</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Skin art, recovered from the embedded resource of the prebuilt Voidcrid_Skins.dll. Like
      acrid3 it is a build output with no source in the repo, and SkinSetup resolves it as a
      sibling of Voidcrid.dll.
    -->
    <None Include="$(AssetsDir)voidcrid_skins">
      <Link>voidcrid_skins</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Mirror the build output into a single config-independent directory so a mod manager profile can
    symlink at a stable path. Without this the symlink would have to name a configuration, and a
    plain `dotnet build` (Debug) would leave the game running the last Release build instead.
    See docs/DEVELOPMENT.md, "Live-testing through r2modman".
  -->
  <PropertyGroup>
    <LiveDir>$(MSBuildThisFileDirectory)bin\live\</LiveDir>
    <R2ModmanPluginDir Condition="'$(R2ModmanPluginDir)' == ''">$(HOME)/.config/r2modmanPlus-local/RiskOfRain2/profiles/Default/BepInEx/plugins/Voidcrid-Voidcrid/</R2ModmanPluginDir>
  </PropertyGroup>

  <Target Name="StageLiveBuild" AfterTargets="Build">
    <ItemGroup>
      <LivePayload Include="$(TargetPath)" />
      <LivePayload Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <LivePayload Include="$(TargetDir)acrid3" />
      <LivePayload Include="$(TargetDir)voidcrid_skins" />
    </ItemGroup>
    <Copy SourceFiles="@(LivePayload)" DestinationFolder="$(LiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LivePayload)" DestinationFolder="$(R2ModmanPluginDir)" SkipUnchangedFiles="true" Condition="Exists('$(R2ModmanPluginDir)')" />
  </Target>

  <!--
    Release builds also produce the Thunderstore upload at dist\Voidcrid-<Version>.zip, with every
    file at the archive root. <Version> is read from packaging\manifest.json itself, so the two
    can never disagree.
  -->
  <PropertyGroup>
    <PackagingDir>$(RepoRoot)packaging\</PackagingDir>
    <DistDir>$(RepoRoot)dist\</DistDir>
    <ThunderstoreStageDir>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)thunderstore\</ThunderstoreStageDir>
  </PropertyGroup>

  <Target Name="PackThunderstore" AfterTargets="StageLiveBuild" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ThunderstorePayload Include="@(LivePayload)" />
      <ThunderstorePayload Include="$(PackagingDir)manifest.json;$(PackagingDir)icon.png;$(PackagingDir)README.md;$(PackagingDir)CHANGELOG.md" />
    </ItemGroup>
    <RemoveDir Directories="$(ThunderstoreStageDir)" />
    <Copy SourceFiles="@(ThunderstorePayload)" DestinationFolder="$(ThunderstoreStageDir)" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(ThunderstoreStageDir)" DestinationFile="$(DistDir)Voidcrid-$(Version).zip" Overwrite="true" />
  </Target>

</Project>
